# Copy this file to .env.local and fill in real values.
# Get the actual credentials from the Netlify dashboard's environment
# variable settings for this project.

# MongoDB (blog data)
MONGODB_URI=
DATABASE_NAME=

# Contact form email (Zoho SMTP)
COMPANY_SMTP_HOST=
COMPANY_SMTP_PORT=465
COMPANY_USER=
COMPANY_APP_PASSWORD=

BASE_URL=http://localhost:3000

# Admin login (see scripts/hash-password.js to generate ADMIN_PASSWORD_HASH)
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
# Random secret used to sign admin session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Google Gemini API key, used by the "Generate with AI" button on the blog admin page.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Pexels API key, used to fetch topic-relevant cover photos for blog cards.
# Get a free key at https://www.pexels.com/api/
PEXELS_API_KEY=
